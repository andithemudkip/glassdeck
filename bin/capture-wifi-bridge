#!/usr/bin/env bash
# Start a WiFi-tethered CAN capture from the wifi-bridge WebSocket.
# Usage: capture-wifi-bridge <label> [host] [extra capture.py args...]
#
# Pipes SLCAN from ws://<host>/stream into scripts/capture.py --stdin. Note
# this is the desk/laptop path — for on-bike rider captures use the browser
# at http://<host>/ (M4 OPFS capture), then Export and consume the file with
# 'python scripts/capture.py --stdin --label <label> < downloaded.log'.
#
# Requires websocat: `brew install websocat`.

set -euo pipefail
source "$(dirname "$0")/_common.sh"

label="${1:-}"
if [[ -z "$label" || "$label" == "-h" || "$label" == "--help" ]]; then
    cat >&2 <<EOF
usage: capture-wifi-bridge <label> [host] [extra capture.py args]

Pipes ws://<host>/stream into 'python scripts/capture.py --stdin'. Default
host is $DEFAULT_HOST. Requires websocat.

For rider-side captures use the browser at http://<host>/ instead —
OPFS survives WS drops, this desk path does not.
EOF
    exit 1
fi
shift

host="$DEFAULT_HOST"
if [[ $# -gt 0 && "$1" != -* ]]; then
    host="$1"; shift
fi

require_cmd websocat "brew install websocat"
require_cmd python3

info "streaming ws://$host/stream → logs/*-$label/"
cd "$REPO_ROOT"
# `: |` feeds websocat an empty pipe as stdin so it doesn't fight capture.py
# for terminal keys. websocat is bidirectional by default — without this, it
# steals hotkeys (t, ?, q …) off the TTY and ships them uselessly up the WS.
# `< /dev/null` would look equivalent but websocat fcntl's stdin on macOS
# and errors with EINVAL on character devices; a plain pipe fd is fine.
# `-n` keeps the WS connection alive after the immediate EOF.
#
# When capture.py exits (q / Ctrl-C), websocat's next WS→pipe write gets
# EPIPE and it prints "Broken pipe" + "error running" to stderr. Filter
# those specific lines — real connect / protocol errors still surface.
# `set +o pipefail` on this pipeline: exit status follows capture.py, not
# websocat's SIGPIPE on shutdown.
set +o pipefail
: | websocat -n "ws://$host/stream" \
    2> >(grep -v -E "(Broken pipe|error running)" >&2) \
  | python3 scripts/capture.py --stdin --label "$label" "$@"
