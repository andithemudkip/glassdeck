// wifi_secrets.h — WPA2 password for the wifi-bridge soft-AP.
//
// SETUP: copy this file to `wifi_secrets.h` (same directory) and edit the
// password. `wifi_secrets.h` is git-ignored; this `.example` is checked in as
// documentation. main.c #includes "wifi_secrets.h", never the .example.
//
//     cp firmware/wifi-bridge/main/wifi_secrets.h.example \
//        firmware/wifi-bridge/main/wifi_secrets.h
//     # then edit the WIFI_AP_PASSWORD line below
//
// The password is compiled into the binary and printed to USB-CDC on boot so
// the operator can copy it into the phone's WiFi picker. Rotate whenever you
// want — the ADR does not require synchronisation with anything else.
//
// Requirements: 8..63 ASCII characters (WPA2-PSK).

#pragma once

#define WIFI_AP_PASSWORD "changeme-see-wifi_secrets.h.example"
